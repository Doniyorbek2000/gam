  - m_Id: 6447775750
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775751
    m_Localized: "\u0422\u0435\u0441\u0442\u043E\u0432\u044B\u0439 \u0440\u0435\u0436\u0438\u043C:
      +{0} \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775752
    m_Localized: "\u0422\u0435\u0441\u0442\u043E\u0432\u044B\u0439 \u0440\u0435\u0436\u0438\u043C:
      +{0} \u0433\u0435\u043C\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775753
    m_Localized: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043C\u043E\u043D\u0435\u0442 \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u0437\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775754
    m_Localized: "\u0420\u0435\u0436\u0438\u043C \u0438 \u0437\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775755
    m_Localized: "\u041D\u0430 \u043E\u0434\u043D\u043E\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775756
    m_Localized: "\u0421 \u0434\u0440\u0443\u0433\u043E\u043C \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438,
      \u0431\u0435\u0437 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775757
    m_Localized: "\u0421 \u0434\u0440\u0443\u0433\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775758
    m_Localized: "\u041E\u043D\u043B\u0430\u0439\u043D \u043F\u043E \u043A\u043E\u0434\u0443
      \u043A\u043E\u043C\u043D\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775759
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u0438\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775760
    m_Localized: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A,
      \u043D\u0430 \u043F\u0440\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775761
    m_Localized: "\u0420\u0435\u0439\u0442\u0438\u043D\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775762
    m_Localized: "\u0420\u0430\u043D\u0433\u0438 \u0438 \u043D\u0430\u0433\u0440\u0430\u0434\u044B
      \u0441\u0435\u0437\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775763
    m_Localized: "\u0421 \u0431\u043E\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775764
    m_Localized: "4 \u0443\u0440\u043E\u0432\u043D\u044F \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775765
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775766
    m_Localized: "\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430,
      \u0442\u0440\u044E\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775767
    m_Localized: "\u0417\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775768
    m_Localized: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775769
    m_Localized: "\u0417\u0430\u043B \u0438 \u0441\u043A\u0438\u043D\u044B \u2014
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043D\u0435\u0448\u043D\u0438\u0439
      \u0432\u0438\u0434: \u0444\u0438\u0437\u0438\u043A\u0430, \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u0438 \u0442\u0430\u0439\u043C\u0435\u0440 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B
      \u0434\u043B\u044F \u0432\u0441\u0435\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 6447775770
    m_Localized: "\u0421 \u0443\u0440\u043E\u0432\u043D\u044F {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775771
    m_Localized: "\u0411\u0435\u0437 \u0441\u0442\u0430\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775772
    m_Localized: "\u0418\u0433\u0440\u0430 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775773
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775774
    m_Localized: "\u041A\u043E\u0434 \u0438\u0437 6 \u0446\u0438\u0444\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775775
    m_Localized: "\u0412\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775776
    m_Localized: "\u0438\u043B\u0438 \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u043E\u0434
      \u0434\u0440\u0443\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775777
    m_Localized: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043C\u0441\u044F
      \u0432 \u0432\u0430\u0448\u0443 \u0438\u0433\u0440\u0443\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775778
    m_Localized: "\u0418\u0449\u0435\u043C \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775779
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0451\u043C \u043A\u043E\u043C\u043D\u0430\u0442\u0443\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775780
    m_Localized: "\u041A\u043E\u0434 \u043A\u043E\u043C\u043D\u0430\u0442\u044B:
      <b>{0}</b>\n\u041E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u0434\u0440\u0443\u0433\u0443.
      \u0416\u0434\u0451\u043C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775781
    m_Localized: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 6-\u0437\u043D\u0430\u0447\u043D\u044B\u0439
      \u043A\u043E\u0434 \u043A\u043E\u043C\u043D\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775782
    m_Localized: "\u0412\u0445\u043E\u0434\u0438\u043C \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443
      {0}\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775783
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775784
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775785
    m_Localized: "\u043D\u0435\u0442 \u0441\u0432\u044F\u0437\u0438 \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775786
    m_Localized: "\u041D\u0435\u0442 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
      \u043A \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0443"
    m_Metadata:
