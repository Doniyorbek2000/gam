    m_Localized: "\u041F\u0440\u043E\u0444\u0438\u043B\u044C, \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C,
      \u0432\u0430\u043B\u044E\u0442\u0430 \u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u0431\u0443\u0434\u0443\u0442 \u0443\u0434\u0430\u043B\u0435\u043D\u044B \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430.
      \u042D\u0442\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
