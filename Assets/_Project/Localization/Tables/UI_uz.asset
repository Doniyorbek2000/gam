      m_Items: []
  - m_Id: 6447775775
    m_Localized: Kirish
    m_Metadata:
      m_Items: []
  - m_Id: 6447775776
    m_Localized: yoki do'stingiz kodini kiriting
    m_Metadata:
      m_Items: []
  - m_Id: 6447775777
    m_Localized: "O'yiningizga qaytilmoqda\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775778
    m_Localized: "Raqib qidirilmoqda\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775779
    m_Localized: "Xona ochilmoqda\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6447775780
    m_Localized: "Xona kodi: <b>{0}</b>\nDo'stingizga yuboring. Kutilmoqda\u2026"
