# Copy to Server/.env (git-ignored) and fill in. Never commit real values.
# Crate RNG key, at least 16 chars, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRATE_SECRET=
# Bump when the key is rotated; stored with every crate roll for audits.
CRATE_SECRET_VERSION=1
POSTGRES_PASSWORD=localdb
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me
