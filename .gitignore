# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / generated project files
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# Unity crash / build artifacts
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Mobile builds and signing
*.apk
*.aab
*.unitypackage
*.app
*.keystore
*.jks

# Secrets
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Unity build temp
/.utmp/

# MCP screenshots
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta

# Cross-check tool (the *.csproj rule above targets Unity-generated projects)
!/Tools/**/*.csproj
/Tools/**/bin/
/Tools/**/obj/

# Raw art downloads (imported copies live under Assets/_Project/Art; ART_PIPELINE §1)
/ArtSource/Incoming/

# UI generator tools
Tools/UI/node_modules/
Tools/Art/__pycache__/
