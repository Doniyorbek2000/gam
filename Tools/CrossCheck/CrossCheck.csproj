<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity Physics + Gameplay sources outside Unity and writes reference fixtures for the
       TypeScript server port (Server/nakama/modules/test). Unity is C# 9, so pin the language version. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Physics/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Gameplay/**/*.cs" />
  </ItemGroup>
</Project>
