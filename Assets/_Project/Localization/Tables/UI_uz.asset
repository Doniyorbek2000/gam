    m_Metadata:
      m_Items: []
  - m_Id: 6447775756
    m_Localized: Do'st bilan navbatma-navbat, internetsiz
    m_Metadata:
      m_Items: []
  - m_Id: 6447775757
    m_Localized: Do'st bilan
    m_Metadata:
      m_Items: []
  - m_Id: 6447775758
    m_Localized: Xona kodi orqali onlayn
    m_Metadata:
      m_Items: []
  - m_Id: 6447775759
    m_Localized: Tezkor o'yin
    m_Metadata:
      m_Items: []
  - m_Id: 6447775760
    m_Localized: Tasodifiy raqib, sovrin uchun
    m_Metadata:
      m_Items: []
  - m_Id: 6447775761
    m_Localized: Reytingli
    m_Metadata:
      m_Items: []
  - m_Id: 6447775762
