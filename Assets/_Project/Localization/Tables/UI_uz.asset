      m_Items: []
  - m_Id: 6451970112
    m_Localized: Kuchaytirish
    m_Metadata:
      m_Items: []
  - m_Id: 6451970113
    m_Localized: 'Qayerdan: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 6451970114
    m_Localized: Sizda bor
    m_Metadata:
      m_Items: []
  - m_Id: 6451970115
    m_Localized: 'Faqat ko''rinish: zarba kuchi va aniqlikka ta''sir qilmaydi.'
    m_Metadata:
      m_Items: []
  - m_Id: 6451970116
    m_Localized: Bu bo'lim hozircha bo'sh
    m_Metadata:
      m_Items: []
  - m_Id: 6451970117
    m_Localized: Yangi kosmetika keyingi mavsumlarda va yashiklarda chiqadi.
    m_Metadata:
      m_Items: []
  - m_Id: 6451970118
    m_Localized: Yashiklarga
    m_Metadata:
      m_Items: []
  - m_Id: 6451970119
    m_Localized: "Shard: {0}  \xB7  Kristall: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970120
    m_Localized: 'Jihozlandi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 6451970121
    m_Localized: 'Stiker yopishtirildi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 6451970122
    m_Localized: Aylantirish uchun suring
    m_Metadata:
      m_Items: []
  - m_Id: 6451970123
    m_Localized: Boshlang'ich
    m_Metadata:
      m_Items: []
  - m_Id: 6451970124
    m_Localized: Yashik
    m_Metadata:
      m_Items: []
  - m_Id: 6451970125
    m_Localized: Do'kon
    m_Metadata:
      m_Items: []
  - m_Id: 6451970126
    m_Localized: Mavsum pasi
    m_Metadata:
      m_Items: []
  - m_Id: 6451970127
    m_Localized: "Kiy \u2014 o'yin uslubingizning ko'rinishi."
    m_Metadata:
      m_Items: []
  - m_Id: 6451970128
    m_Localized: 'Stol matosi va bortlari: lobbi, xona va o''yinda ko''rinadi.'
    m_Metadata:
      m_Items: []
  - m_Id: 6451970129
    m_Localized: Kiy yoki stol bortiga yopishtiring, chatda yuboring, xona devoriga
      osing.
    m_Metadata:
      m_Items: []
  - m_Id: 6451970130
    m_Localized: 'Avatar atrofidagi ramka: lobbi, profil va o''yinda.'
    m_Metadata:
      m_Items: []
  - m_Id: 6451970131
    m_Localized: '"Mening xonam" uchun devor temasi.'
    m_Metadata:
      m_Items: []
  - m_Id: 6451970132
    m_Localized: '"Mening xonam" uchun pol temasi.'
    m_Metadata:
      m_Items: []
  - m_Id: 6451970133
    m_Localized: "Kosmetika \u2014 faqat ko'rinish."
    m_Metadata:
      m_Items: []
  - m_Id: 6451970134
    m_Localized: Oddiy
    m_Metadata:
      m_Items: []
  - m_Id: 6451970135
    m_Localized: Noyob
