    m_Metadata:
      m_Items: []
  - m_Id: 6447775763
    m_Localized: Bot bilan
    m_Metadata:
      m_Items: []
  - m_Id: 6447775764
    m_Localized: 4 qiyinlik darajasi
    m_Metadata:
      m_Items: []
  - m_Id: 6447775765
    m_Localized: Mashq
    m_Metadata:
      m_Items: []
  - m_Id: 6447775766
    m_Localized: Erkin joylashtirish, maxsus zarbalar
    m_Metadata:
      m_Items: []
  - m_Id: 6447775767
    m_Localized: Zal
    m_Metadata:
      m_Items: []
  - m_Id: 6447775768
    m_Localized: Tanlash
    m_Metadata:
      m_Items: []
  - m_Id: 6447775769
    m_Localized: 'Zal va kosmetika faqat ko''rinish: fizika, qoidalar va taymer hamma
      uchun bir xil.'
    m_Metadata:
      m_Items: []
  - m_Id: 6447775770
