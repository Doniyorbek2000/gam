    m_Metadata:
      m_Items: []
  - m_Id: 6435192846
    m_Localized: "\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6435192847
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0437\u0430\u043B.
      \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 6435192848
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u0438\u043C \u0437\u0430\u043B\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6435192849
    m_Localized: "\u0421\u043E\u0432\u0435\u0442: \u043A\u043E\u043B\u0435\u0441\u043E
      \u0442\u043E\u0447\u043D\u043E\u0439 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u043A\u0438\u0439
      \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044B\u0435 \u0434\u043E\u043B\u0438
      \u0433\u0440\u0430\u0434\u0443\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6435192850
    m_Localized: "\u0421\u043E\u0432\u0435\u0442: \u0443\u0434\u0430\u0440 \u0432
      \u043D\u0438\u0437 \u0431\u0438\u0442\u043A\u0430 \u0434\u0430\u0451\u0442
      \u043E\u0442\u0442\u044F\u0436\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6435192851
    m_Localized: "\u0421\u043E\u0432\u0435\u0442: \u043A\u043E\u0441\u043C\u0435\u0442\u0438\u043A\u0430
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043D\u0435\u0448\u043D\u0438\u0439
      \u0432\u0438\u0434, \u0444\u0438\u0437\u0438\u043A\u0430 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u0430
      \u0434\u043B\u044F \u0432\u0441\u0435\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 6435192852
    m_Localized: "\u0421\u043E\u0432\u0435\u0442: \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u044F\u0449\u0438\u043A\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B \u0448\u0430\u043D\u0441\u044B
      \u0438 \u0441\u0447\u0451\u0442\u0447\u0438\u043A \u0433\u0430\u0440\u0430\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6435192853
    m_Localized: "\u0421\u043E\u0432\u0435\u0442: \u0440\u0435\u0436\u0438\u043C
      \u0434\u043B\u044F \u043B\u0435\u0432\u0448\u0438 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442
      \u043F\u043E\u043B\u0437\u0443\u043D\u043E\u043A \u0441\u0438\u043B\u044B \u0432\u043F\u0440\u0430\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6435192854
    m_Localized: "\u0421\u043E\u0432\u0435\u0442: \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0439\u0442\u0435
      \u0442\u0440\u043E\u0444\u0435\u0438 \u0438 \u043A\u0438\u0438 \u0432 \xAB\u041C\u043E\u0435\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 6435192855
