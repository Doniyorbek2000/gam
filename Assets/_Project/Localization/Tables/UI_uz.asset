    m_Metadata:
      m_Items: []
  - m_Id: 6435192846
    m_Localized: Bepul
    m_Metadata:
      m_Items: []
  - m_Id: 6435192847
    m_Localized: Haqiqiy zal. Haqiqiy raqib.
    m_Metadata:
      m_Items: []
  - m_Id: 6435192848
    m_Localized: "Zal tayyorlanmoqda\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6435192849
    m_Localized: 'Maslahat: nozik g''ildirak burchakni o''ndan bir gradusgacha aniq
      buradi.'
    m_Metadata:
      m_Items: []
  - m_Id: 6435192850
    m_Localized: 'Maslahat: oq sharning pastiga urish uni orqaga qaytaradi (draw).'
    m_Metadata:
      m_Items: []
  - m_Id: 6435192851
    m_Localized: "Maslahat: kosmetika faqat ko'rinish \u2014 fizika hamma uchun bir
      xil."
    m_Metadata:
      m_Items: []
  - m_Id: 6435192852
    m_Localized: 'Maslahat: har bir yashikda ehtimollar va kafolat hisoblagichi ochiq
      ko''rinadi.'
    m_Metadata:
      m_Items: []
  - m_Id: 6435192853
    m_Localized: 'Maslahat: chap qo''l rejimi kuch slayderini o''ng tomonga o''tkazadi.'
    m_Metadata:
      m_Items: []
  - m_Id: 6435192854
    m_Localized: 'Maslahat: "Mening xonam"da kuboklar va kiylaringizni ko''z-ko''z
      qiling.'
    m_Metadata:
      m_Items: []
