      m_Items: []
  - m_Id: 6451970114
    m_Localized: "\u0415\u0441\u0442\u044C \u0443 \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970115
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043D\u0435\u0448\u043D\u0438\u0439
      \u0432\u0438\u0434: \u043D\u0435 \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430
      \u0441\u0438\u043B\u0443 \u0438 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6451970116
    m_Localized: "\u042D\u0442\u043E\u0442 \u0440\u0430\u0437\u0434\u0435\u043B \u043F\u043E\u043A\u0430
      \u043F\u0443\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970117
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u043A\u043E\u0441\u043C\u0435\u0442\u0438\u043A\u0430
      \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u0432 \u0441\u0435\u0437\u043E\u043D\u0430\u0445
      \u0438 \u044F\u0449\u0438\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 6451970118
    m_Localized: "\u041A \u044F\u0449\u0438\u043A\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970119
    m_Localized: "\u041E\u0441\u043A\u043E\u043B\u043A\u0438: {0}  \xB7  \u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B:
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970120
    m_Localized: "\u041D\u0430\u0434\u0435\u0442\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970121
    m_Localized: "\u0421\u0442\u0438\u043A\u0435\u0440 \u043D\u0430\u043A\u043B\u0435\u0435\u043D:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970122
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0440\u0430\u0449\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970123
    m_Localized: "\u0421\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970124
    m_Localized: "\u042F\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970125
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970126
    m_Localized: "\u0411\u043E\u0435\u0432\u043E\u0439 \u043F\u0440\u043E\u043F\u0443\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 6451970127
    m_Localized: "\u041A\u0438\u0439 \u2014 \u0432\u043D\u0435\u0448\u043D\u0438\u0439
      \u0432\u0438\u0434 \u0432\u0430\u0448\u0435\u0433\u043E \u0441\u0442\u0438\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6451970128
    m_Localized: "\u0421\u0443\u043A\u043D\u043E \u0438 \u0431\u043E\u0440\u0442\u0430:
      \u0432\u0438\u0434\u043D\u043E \u0432 \u043B\u043E\u0431\u0431\u0438, \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u0438 \u043C\u0430\u0442\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6451970129
    m_Localized: "\u041D\u0430\u043A\u043B\u0435\u0439\u0442\u0435 \u043D\u0430 \u043A\u0438\u0439
      \u0438\u043B\u0438 \u0431\u043E\u0440\u0442, \u043E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435
      \u0432 \u0447\u0430\u0442, \u043F\u043E\u0432\u0435\u0441\u044C\u0442\u0435
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0443 \u043A\u043E\u043C\u043D\u0430\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6451970130
    m_Localized: "\u0420\u0430\u043C\u043A\u0430 \u0430\u0432\u0430\u0442\u0430\u0440\u0430:
      \u0432 \u043B\u043E\u0431\u0431\u0438, \u043F\u0440\u043E\u0444\u0438\u043B\u0435
      \u0438 \u043C\u0430\u0442\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6451970131
    m_Localized: "\u0422\u0435\u043C\u0430 \u0441\u0442\u0435\u043D \u0434\u043B\u044F
      \xAB\u041C\u043E\u0435\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u044B\xBB."
    m_Metadata:
      m_Items: []
